{
  "version": 1,
  "profiles": [
    {
      "id": "local",
      "name": "Local / Clean",
      "description": "Use the host shell and environment without changing proxy, timezone, locale, or HOME.",
      "terminal": {
        "backend": "auto",
        "shell": "inherit",
        "cwd": "~"
      },
      "identity": {
        "timezone": "inherit",
        "locale": "inherit"
      },
      "environment": {},
      "proxy": {
        "mode": "inherit",
        "http": "",
        "https": "",
        "all": "",
        "no_proxy": ""
      },
      "home": {
        "mode": "inherit"
      }
    },
    {
      "id": "sg-example",
      "name": "Singapore Example",
      "description": "Example identity/environment profile. Proxy is intentionally disabled until real endpoints are configured.",
      "terminal": {
        "backend": "auto",
        "shell": "inherit",
        "cwd": "~"
      },
      "identity": {
        "timezone": "Asia/Singapore",
        "locale": "en_SG.UTF-8"
      },
      "environment": {},
      "proxy": {
        "mode": "off",
        "http": "",
        "https": "",
        "all": "",
        "no_proxy": "localhost,127.0.0.1,::1"
      },
      "home": {
        "mode": "inherit"
      }
    },
    {
      "id": "strict-auto-ip",
      "name": "Strict Fingerprint / Auto IP",
      "description": "Transparent IP identity plus a private Bubblewrap filesystem, process view, HOME, runtime sockets, machine-id and user identity. Only explicitly shared directories are visible.",
      "terminal": {
        "backend": "auto",
        "shell": "inherit",
        "cwd": "~"
      },
      "identity": {
        "timezone": "inherit",
        "locale": "inherit",
        "hostname": "auto"
      },
      "environment": {},
      "proxy": {
        "mode": "off",
        "http": "",
        "https": "",
        "all": "",
        "no_proxy": ""
      },
      "network": {
        "mode": "transparent",
        "proxy_host": "127.0.0.1",
        "proxy_port": 7898,
        "proxy_protocol": "mixed",
        "auto_identity": true,
        "lock_exit": true,
        "private_hostname": true
      },
      "home": {
        "mode": "isolated"
      },
      "sandbox": {
        "mode": "strict",
        "username": "dev",
        "clipboard": "wayland",
        "shares": [
          {
            "source": "~/code",
            "target": "code",
            "mode": "rw"
          }
        ]
      }
    }
  ]
}
